# Node / Next.js (interactive_plan)
node_modules/
.next/
out/
test-results/
playwright-report/
coverage/
.lint/
*.tsbuildinfo
next-env.d.ts

# approvals store temp/lock files (plan app)
plan/.approvals.lock
plan/approvals.json.tmp-*
plan/.approvals.lock.stale-*
plan/snapshots/**/*.tmp-*

# Python bytecode (tools/ tests)
__pycache__/

# Rust: build output of the workspace and of every spike (spikes/*/target/ is matched by target/)
target/

# Benchmark output (raw results are archived under wiki/raw/bench/, never here) and trace files
benchmarks/results/
*.etl

# Browser profiles created by spikes, tests and benchmarks (never commit browsing data)
profiles/
**/profiles/
*.profile/

# Local / sensitive (never commit browser profiles, tokens, raw browsing data)
# .env.local-map holds the real machine values behind the masks (adr-0027); also covered by .env*
.env.local-map
.env*
!.env.example
**/EBWebView/
# Ferrum's library (history and bookmarks) and its copies, and backup files (P3 self-scan, 2026-10-13)
ferrum.db*
*.ferrum-backup
*.user-data/
logs/netlog/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
