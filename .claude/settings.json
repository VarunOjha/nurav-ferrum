{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh",
            "args": [
              "-NoProfile",
              "-NonInteractive",
              "-File",
              "${CLAUDE_PROJECT_DIR}/tools/portal-sync-check.ps1",
              "-Hook",
              "-Root",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
