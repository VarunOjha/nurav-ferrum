{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ferrum telemetry export, schema v1: one JSON object per line",
  "description": "Each file: the run line first (type run), then records with t_ms never decreasing; LF line ends, final line break. Kept in step with crates/telemetry/src/export/records.rs by the test json_schema_matches_the_types (p5.1).",
  "oneOf": [
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/process_sample"
    },
    {
      "$ref": "#/$defs/tree_sample"
    },
    {
      "$ref": "#/$defs/sample_gap"
    },
    {
      "$ref": "#/$defs/startup_mark"
    },
    {
      "$ref": "#/$defs/nav_timing"
    }
  ],
  "$defs": {
    "run": {
      "description": "The run label: the first line of every file and nowhere else.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schema_version",
        "run_id",
        "file_seq",
        "started_unix_ms",
        "ferrum_version",
        "git_sha",
        "git_dirty",
        "os_build",
        "webview2_runtime",
        "config_sha256",
        "machine_id",
        "sample_interval_ms"
      ],
      "properties": {
        "type": {
          "const": "run"
        },
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "file_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "started_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "ferrum_version": {
          "type": "string",
          "minLength": 1
        },
        "git_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "git_dirty": {
          "type": "boolean"
        },
        "os_build": {
          "type": "string",
          "minLength": 1
        },
        "webview2_runtime": {
          "type": "string",
          "minLength": 1
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "machine_id": {
          "type": "string",
          "minLength": 1
        },
        "sample_interval_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "process_sample": {
      "description": "The counters of one process at one moment.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "t_ms",
        "pid",
        "pid_created_100ns",
        "kind",
        "private_commit_bytes",
        "working_set_bytes",
        "private_working_set_bytes",
        "page_faults",
        "cpu_user_100ns",
        "cpu_kernel_100ns",
        "cycles"
      ],
      "properties": {
        "type": {
          "const": "process_sample"
        },
        "t_ms": {
          "type": "integer",
          "minimum": 0
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "pid_created_100ns": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "enum": [
            "host",
            "browser",
            "renderer",
            "gpu",
            "utility",
            "other"
          ]
        },
        "private_commit_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "working_set_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "private_working_set_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "page_faults": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_user_100ns": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_kernel_100ns": {
          "type": "integer",
          "minimum": 0
        },
        "cycles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "tree_sample": {
      "description": "The sum over the attributed process set at one moment (headline series).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "t_ms",
        "process_count",
        "private_commit_bytes",
        "working_set_bytes",
        "cpu_100ns",
        "cycles"
      ],
      "properties": {
        "type": {
          "const": "tree_sample"
        },
        "t_ms": {
          "type": "integer",
          "minimum": 0
        },
        "process_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "private_commit_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "working_set_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_100ns": {
          "type": "integer",
          "minimum": 0,
          "description": "Sum of user and kernel CPU time of every process of the set seen during the run, exited ones included at their last reading."
        },
        "cycles": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "sample_gap": {
      "description": "A sampling moment with no sum, because the set or a member's counters could not be read completely; a smaller number is never written instead (p5.3).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "t_ms",
        "reason",
        "missing"
      ],
      "properties": {
        "type": {
          "const": "sample_gap"
        },
        "t_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "enum": [
            "set_refused",
            "counters_unreadable"
          ]
        },
        "missing": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "For counters_unreadable: how many members could not be read; null for set_refused."
        }
      }
    },
    "startup_mark": {
      "description": "One startup boundary.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "t_ms",
        "mark",
        "tab"
      ],
      "properties": {
        "type": {
          "const": "startup_mark"
        },
        "t_ms": {
          "type": "integer",
          "minimum": 0
        },
        "mark": {
          "type": "string",
          "enum": [
            "process_created",
            "window_visible",
            "shell_first_paint",
            "tab_first_contentful_paint",
            "tab_largest_contentful_paint"
          ]
        },
        "tab": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "nav_timing": {
      "description": "The timing of one finished navigation; offsets in ms after start_ms.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "t_ms",
        "tab",
        "nav_id",
        "start_ms",
        "response_ms",
        "dom_content_loaded_ms",
        "load_ms",
        "complete_ms",
        "origin",
        "redirect_count",
        "outcome"
      ],
      "properties": {
        "type": {
          "const": "nav_timing"
        },
        "t_ms": {
          "type": "integer",
          "minimum": 0
        },
        "tab": {
          "type": "integer",
          "minimum": 0
        },
        "nav_id": {
          "type": "integer",
          "minimum": 0
        },
        "start_ms": {
          "type": "number",
          "minimum": 0
        },
        "response_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "dom_content_loaded_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "load_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "complete_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "origin": {
          "type": "string",
          "enum": [
            "same_origin",
            "cross_origin"
          ]
        },
        "redirect_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "outcome": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        }
      }
    }
  }
}
