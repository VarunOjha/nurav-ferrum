{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "The trusted shell web view only (label \"shell\"). No remote section: no website may use any command (trust rules R1-R3).",
  "webviews": ["shell"],
  "permissions": [
    "core:event:default",
    "allow-app-ping",
    "allow-app-quit",
    "allow-shell-layout",
    "allow-shell-cover",
    "allow-tab-navigate",
    "allow-tab-back",
    "allow-tab-forward",
    "allow-tab-reload",
    "allow-tab-stop",
    "allow-tab-new",
    "allow-tab-close",
    "allow-tab-activate",
    "allow-tab-move",
    "allow-tab-next",
    "allow-tab-previous",
    "allow-tab-reopen",
    "allow-tab-list",
    "allow-test-stats",
    "allow-test-focus",
    "allow-test-crash",
    "allow-history-list",
    "allow-history-clear",
    "allow-history-remove",
    "allow-library-suggest",
    "allow-bookmark-list",
    "allow-bookmark-for",
    "allow-bookmark-add",
    "allow-bookmark-update",
    "allow-bookmark-move",
    "allow-bookmark-remove",
    "allow-appearance-get",
    "allow-appearance-set",
    "allow-settings-get",
    "allow-settings-set",
    "allow-shell-focused",
    "allow-external-open-confirm",
    "allow-external-cancel",
    "allow-cross-site-confirm",
    "allow-cross-site-cancel"
  ]
}
