{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research.schema.json",
  "title": "research.json - questions, hypotheses, experiments, metrics, workloads",
  "description": "One item per page under wiki/research/{questions,hypotheses,experiments,metrics,workloads}/. The narrative ov-research-* pages are not translated.",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "questions",
    "hypotheses",
    "experiments",
    "metrics",
    "workloads"
  ],
  "properties": {
    "$schema": {
      "$ref": "#/$defs/schema_ref"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "related",
          "source",
          "question"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^rq-[0-9]{2,}$"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "status": {
            "$ref": "#/$defs/status_label"
          },
          "related": {
            "$ref": "#/$defs/id_list"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\n]+$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "related",
          "source",
          "prediction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^hyp-[0-9]{2,}$"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "status": {
            "$ref": "#/$defs/status_label"
          },
          "related": {
            "$ref": "#/$defs/id_list"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "prediction": {
            "$ref": "#/$defs/short_text"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "related",
          "source",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^exp-[a-z0-9-]+$"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "status": {
            "$ref": "#/$defs/status_label"
          },
          "related": {
            "$ref": "#/$defs/id_list"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "phase": {
            "$ref": "#/$defs/phase_id"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "related",
          "source",
          "unit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^metric-[a-z0-9-]+$"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "status": {
            "$ref": "#/$defs/status_label"
          },
          "related": {
            "$ref": "#/$defs/id_list"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[^\\n]+$"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "workloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "related",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^wl-[a-z0-9-]+$"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "status": {
            "$ref": "#/$defs/status_label"
          },
          "related": {
            "$ref": "#/$defs/id_list"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "additionalProperties": false
}
