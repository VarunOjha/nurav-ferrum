{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research.schema.json",
  "title": "research.json - questions, hypotheses, experiments, metrics, workloads",
  "description": "One item per page under wiki/research/{questions,hypotheses,experiments,metrics,workloads}/. The narrative ov-research-* pages are not translated. The portal shows all five lists as one list; 'category' says which kind each item is.",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "questions",
    "hypotheses",
    "experiments",
    "metrics",
    "workloads"
  ],
  "properties": {
    "$schema": {
      "$ref": "#/$defs/schema_ref"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "related",
          "source",
          "question",
          "category",
          "tags",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^rq-[0-9]{2,}$"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "status": {
            "$ref": "#/$defs/status_label"
          },
          "related": {
            "$ref": "#/$defs/id_list"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\n]+$"
          },
          "category": {
            "$ref": "#/$defs/label",
            "description": "The kind of item, from 'research_categories' in taxonomy.json. Always 'Research question' in this list (checked by tools/portal-sync-check.ps1, BAD-LABEL)."
          },
          "tags": {
            "$ref": "#/$defs/tag_pair"
          },
          "phase": {
            "$ref": "#/$defs/phase_id",
            "description": "The page's frontmatter phase: the phase where this item is built, measured or answered."
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "related",
          "source",
          "prediction",
          "category",
          "tags",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^hyp-[0-9]{2,}$"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "status": {
            "$ref": "#/$defs/status_label"
          },
          "related": {
            "$ref": "#/$defs/id_list"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "prediction": {
            "$ref": "#/$defs/short_text"
          },
          "category": {
            "$ref": "#/$defs/label",
            "description": "The kind of item, from 'research_categories' in taxonomy.json. Always 'Prediction' in this list (checked by tools/portal-sync-check.ps1, BAD-LABEL)."
          },
          "tags": {
            "$ref": "#/$defs/tag_pair"
          },
          "phase": {
            "$ref": "#/$defs/phase_id",
            "description": "The page's frontmatter phase: the phase where this item is built, measured or answered."
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "related",
          "source",
          "phase",
          "category",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^exp-[a-z0-9-]+$"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "status": {
            "$ref": "#/$defs/status_label"
          },
          "related": {
            "$ref": "#/$defs/id_list"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "phase": {
            "$ref": "#/$defs/phase_id",
            "description": "The page's frontmatter phase: the phase where this item is built, measured or answered."
          },
          "category": {
            "$ref": "#/$defs/label",
            "description": "The kind of item, from 'research_categories' in taxonomy.json. Always 'Experiment' in this list (checked by tools/portal-sync-check.ps1, BAD-LABEL)."
          },
          "tags": {
            "$ref": "#/$defs/tag_pair"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "related",
          "source",
          "unit",
          "category",
          "tags",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^metric-[a-z0-9-]+$"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "status": {
            "$ref": "#/$defs/status_label"
          },
          "related": {
            "$ref": "#/$defs/id_list"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[^\\n]+$"
          },
          "category": {
            "$ref": "#/$defs/label",
            "description": "The kind of item, from 'research_categories' in taxonomy.json. Always 'Measure' in this list (checked by tools/portal-sync-check.ps1, BAD-LABEL)."
          },
          "tags": {
            "$ref": "#/$defs/tag_pair"
          },
          "phase": {
            "$ref": "#/$defs/phase_id",
            "description": "The page's frontmatter phase: the phase where this item is built, measured or answered."
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "workloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "status",
          "related",
          "source",
          "category",
          "tags",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^wl-[a-z0-9-]+$"
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "summary": {
            "$ref": "#/$defs/summary"
          },
          "status": {
            "$ref": "#/$defs/status_label"
          },
          "related": {
            "$ref": "#/$defs/id_list"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "category": {
            "$ref": "#/$defs/label",
            "description": "The kind of item, from 'research_categories' in taxonomy.json. Always 'Test site' in this list (checked by tools/portal-sync-check.ps1, BAD-LABEL)."
          },
          "tags": {
            "$ref": "#/$defs/tag_pair"
          },
          "phase": {
            "$ref": "#/$defs/phase_id",
            "description": "The page's frontmatter phase: the phase where this item is built, measured or answered."
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "additionalProperties": false
}
