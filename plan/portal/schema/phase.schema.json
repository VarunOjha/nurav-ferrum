{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase.schema.json",
  "title": "phases/<phase-id>.json - one phase, shown in the phase popup",
  "description": "Translated from wiki/phases/<phase-id>.md. Task progress (each task's status and progress.done) comes from STATUS.md and the log (the phase page does not store it); the checker keeps progress.done equal to the number of 'Done' tasks.",
  "type": "object",
  "required": [
    "id",
    "short",
    "title",
    "one_line_goal",
    "summary",
    "status",
    "progress",
    "step_order",
    "tasks",
    "test_gate",
    "related",
    "source"
  ],
  "properties": {
    "$schema": {
      "$ref": "#/$defs/schema_ref"
    },
    "id": {
      "$ref": "#/$defs/phase_id"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "short": {
      "type": "string",
      "pattern": "^P[0-8]$"
    },
    "one_line_goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[^\\n]+$"
    },
    "status": {
      "$ref": "#/$defs/phase_status"
    },
    "progress": {
      "type": "object",
      "required": [
        "done",
        "total"
      ],
      "properties": {
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "step_order": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "^[^\\n]+$"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "chain",
          "check",
          "script"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^p[0-8]\\.[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70,
            "pattern": "^[^\\n]+$"
          },
          "status": {
            "enum": [
              "Done",
              "In progress",
              "Waiting for you",
              "Not started"
            ],
            "description": "Where this task stands, in plain words. The number of 'Done' tasks must equal progress.done (the checker reports MISMATCH otherwise)."
          },
          "chain": {
            "$ref": "#/$defs/chain"
          },
          "check": {
            "$ref": "#/$defs/short_text"
          },
          "script": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.ps1$",
            "description": "Repo-relative path of a PowerShell 7 script, forward slashes. The file must exist (the checker reports MISSING-SCRIPT otherwise); use null until the script is written."
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "test_gate": {
      "type": "object",
      "required": [
        "explanation",
        "rows",
        "script"
      ],
      "properties": {
        "explanation": {
          "$ref": "#/$defs/chain"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check",
              "proves"
            ],
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[^\\n]+$"
              },
              "proves": {
                "$ref": "#/$defs/short_text"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "script": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.ps1$",
          "description": "Repo-relative path of a PowerShell 7 script, forward slashes. The file must exist (the checker reports MISSING-SCRIPT otherwise); use null until the script is written."
        }
      },
      "additionalProperties": false
    },
    "related": {
      "$ref": "#/$defs/id_list"
    },
    "source": {
      "$ref": "#/$defs/source"
    }
  },
  "additionalProperties": false
}
