{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log.schema.json",
  "title": "log.json - the plain-language log",
  "description": "Translated from wiki/log.md. One entry may group several wiki log entries; 'covers' lists their exact headings, and every heading in wiki/log.md must be covered by some entry (UNCOVERED otherwise).",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "source",
    "entries"
  ],
  "properties": {
    "$schema": {
      "$ref": "#/$defs/schema_ref"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "date",
          "title",
          "done",
          "next",
          "decisions",
          "approvals",
          "commit",
          "covers",
          "category",
          "tags"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "time": {
            "$ref": "#/$defs/time",
            "description": "Time of day of the first wiki log entry this entry covers, from its '- time: HH:MM' line (SCHEMA §12). Only for entries written from 2026-10-10 on."
          },
          "title": {
            "$ref": "#/$defs/title"
          },
          "done": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\n]+$"
          },
          "next": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\n]+$"
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "what",
                "by"
              ],
              "properties": {
                "what": {
                  "$ref": "#/$defs/short_text"
                },
                "by": {
                  "$ref": "#/$defs/who"
                }
              },
              "additionalProperties": false
            },
            "minItems": 0
          },
          "approvals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "what",
                "status"
              ],
              "properties": {
                "what": {
                  "$ref": "#/$defs/short_text"
                },
                "status": {
                  "enum": [
                    "Approved",
                    "Changes requested",
                    "Rejected",
                    "Waiting for you",
                    "Outdated"
                  ]
                }
              },
              "additionalProperties": false
            },
            "minItems": 0
          },
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^## \\[[0-9]{4}-[0-9]{2}-[0-9]{2}\\] "
            },
            "minItems": 1
          },
          "phase": {
            "$ref": "#/$defs/phase_id"
          },
          "category": {
            "$ref": "#/$defs/label",
            "description": "One kind of work from 'log_categories' in taxonomy.json."
          },
          "tags": {
            "$ref": "#/$defs/tag_pair"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "additionalProperties": false
}
